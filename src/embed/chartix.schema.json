{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freber6684.github.io/Chartix/dist/embed/chartix.schema.json",
  "title": "Chartix configuration",
  "description": "A JSON-serializable Chartix chart configuration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "data"],
  "properties": {
    "type": { "type": "string", "minLength": 1 },
    "theme": {
      "oneOf": [
        {
          "enum": [
            "light",
            "dark",
            "minimal",
            "vibrant",
            "corporate",
            "ocean",
            "forest",
            "sunset",
            "rose"
          ]
        },
        { "$ref": "#/$defs/theme" }
      ]
    },
    "data": { "$ref": "#/$defs/data" },
    "options": { "$ref": "#/$defs/options" }
  },
  "$defs": {
    "color": { "type": "string", "minLength": 1 },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "values"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "values": { "type": "array", "minItems": 1, "items": { "type": ["number", "null"] } },
        "color": { "$ref": "#/$defs/color" },
        "type": { "enum": ["bar", "line", "area", "scatter"] },
        "stack": { "type": "string" },
        "yAxisId": { "enum": ["y", "y1"] },
        "radii": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "colors": { "type": "array", "items": { "$ref": "#/$defs/color" } },
        "pointSizes": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "pointShapes": {
          "type": "array",
          "items": { "enum": ["circle", "square", "triangle", "diamond", "cross"] }
        },
        "lineStyle": { "enum": ["straight", "smooth", "step-before", "step-after"] },
        "borderWidth": { "type": "number", "minimum": 0 },
        "borderDash": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "borderColor": { "$ref": "#/$defs/color" },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": { "type": ["number", "string"] },
              "y": { "type": ["number", "null"] },
              "r": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "datasets"],
      "properties": {
        "labels": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "datasets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/dataset" } }
      }
    },
    "labelOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "show": { "type": "boolean" },
        "color": { "$ref": "#/$defs/color" },
        "backgroundColor": { "$ref": "#/$defs/color" },
        "fontFamily": { "type": "string" },
        "fontSize": { "type": "number", "exclusiveMinimum": 0 },
        "fontWeight": { "type": "number", "minimum": 1, "maximum": 1000 },
        "rotation": { "type": "number" },
        "position": { "enum": ["auto", "inside", "outside", "center"] },
        "offset": { "type": "number" }
      }
    },
    "axisOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beginAtZero": { "type": "boolean" },
        "type": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "reverse": { "type": "boolean" },
        "title": { "type": "string" },
        "tickCount": { "type": "integer", "minimum": 2 },
        "format": { "enum": ["auto", "number", "compact", "currency", "percent", "date"] },
        "locale": { "type": "string" },
        "currency": { "type": "string" },
        "tickSkip": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "auto" }] },
        "position": { "enum": ["left", "right", "top", "bottom", "inside"] },
        "labelsInside": { "type": "boolean" },
        "minorTicks": { "type": "boolean" },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/color" },
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "dash": { "type": "number", "minimum": 0 }
          }
        },
        "breaks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": { "from": { "type": "number" }, "to": { "type": "number" } }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["line", "band"] },
              "value": { "type": "number" },
              "from": { "type": "number" },
              "to": { "type": "number" },
              "label": { "type": "string" },
              "color": { "$ref": "#/$defs/color" },
              "width": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        },
        "ariaLabel": { "type": "string" },
        "animation": {
          "oneOf": [
            { "const": false },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "duration": { "type": "number", "minimum": 0 },
                "easing": { "enum": ["easeOutCubic", "easeOutQuad", "linear"] }
              }
            }
          ]
        },
        "backgroundColor": { "$ref": "#/$defs/color" },
        "colors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/color" } },
        "crosshair": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "color": { "$ref": "#/$defs/color" },
            "width": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "dataLabels": { "$ref": "#/$defs/labelOptions" },
        "decimation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "threshold": { "type": "integer", "minimum": 2 },
            "samples": { "oneOf": [{ "type": "integer", "minimum": 4 }, { "const": "auto" }] },
            "algorithm": { "enum": ["min-max", "lttb", "auto"] }
          }
        },
        "fill": { "type": "boolean" },
        "stacked": { "type": "boolean" },
        "stackMode": { "enum": ["normal", "percent"] },
        "spanGaps": { "type": "boolean" },
        "horizontal": { "type": "boolean" },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "innerRadius": { "type": "number", "minimum": 0, "maximum": 0.9 },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "keyboard": { "type": "boolean" },
            "intersect": { "type": "boolean" },
            "mode": { "type": "string", "minLength": 1 }
          }
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interactive": { "type": "boolean" },
            "position": { "enum": ["top", "bottom", "left", "right", "inside"] }
          }
        },
        "drilldown": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/data" }
        },
        "padding": { "type": "number", "minimum": 0 },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoOptimize": { "type": "boolean" },
            "animationThreshold": { "type": "integer", "minimum": 0 }
          }
        },
        "plugins": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "responsive": { "type": "boolean" },
        "responsiveMode": { "enum": ["fixed", "adaptive"] },
        "resizable": { "type": "boolean" },
        "scales": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": { "$ref": "#/$defs/axisOptions" },
            "y": { "$ref": "#/$defs/axisOptions" },
            "y1": { "$ref": "#/$defs/axisOptions" }
          }
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "mode": { "enum": ["brush", "lasso"] },
            "color": { "$ref": "#/$defs/color" }
          }
        },
        "showDataTable": { "type": "boolean" },
        "showGrid": { "type": "boolean" },
        "showLegend": { "type": "boolean" },
        "startAngle": { "type": "number" },
        "radialGap": { "type": "number", "minimum": 0 },
        "explodedSlices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "explodeOffset": { "type": "number", "minimum": 0 },
        "subtitle": { "type": "string" },
        "footnote": { "type": "string" },
        "source": { "type": "string" },
        "watermark": { "type": "string" },
        "title": { "type": "string" },
        "tooltip": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "backgroundColor": { "$ref": "#/$defs/color" },
            "color": { "$ref": "#/$defs/color" }
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "sort" },
                  "by": { "enum": ["label", "value"] },
                  "datasetIndex": { "type": "integer", "minimum": 0 },
                  "direction": { "enum": ["asc", "desc"] }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "filter" },
                  "datasetIndex": { "type": "integer", "minimum": 0 },
                  "min": { "type": "number" },
                  "max": { "type": "number" },
                  "labels": { "type": "array", "items": { "type": "string" } }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "operation", "groupSize"],
                "properties": {
                  "type": { "const": "aggregate" },
                  "operation": { "enum": ["sum", "average", "min", "max"] },
                  "groupSize": { "type": "integer", "minimum": 1 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type"],
                "properties": {
                  "type": { "const": "normalize" },
                  "mode": { "enum": ["percent", "max"] }
                }
              }
            ]
          }
        },
        "typography": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fontFamily": { "type": "string" },
            "titleSize": { "type": "number", "exclusiveMinimum": 0 },
            "labelSize": { "type": "number", "exclusiveMinimum": 0 },
            "tickSize": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "xLabels": { "$ref": "#/$defs/labelOptions" },
        "yLabels": { "$ref": "#/$defs/labelOptions" },
        "zoom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "wheel": { "type": "boolean" },
            "pan": { "type": "boolean" },
            "box": { "type": "boolean" },
            "resetButton": { "type": "boolean" }
          }
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "background",
        "text",
        "mutedText",
        "grid",
        "palette",
        "fontFamily",
        "fontSize",
        "radius"
      ],
      "properties": {
        "name": { "type": "string" },
        "background": { "$ref": "#/$defs/color" },
        "text": { "$ref": "#/$defs/color" },
        "mutedText": { "$ref": "#/$defs/color" },
        "grid": { "$ref": "#/$defs/color" },
        "palette": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/color" } },
        "fontFamily": { "type": "string" },
        "fontSize": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "label", "tick"],
          "properties": {
            "title": { "type": "number", "exclusiveMinimum": 0 },
            "label": { "type": "number", "exclusiveMinimum": 0 },
            "tick": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "radius": { "type": "number", "minimum": 0 }
      }
    }
  }
}
