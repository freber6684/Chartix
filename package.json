{
  "name": "chartix",
  "version": "0.1.0-alpha.2",
  "description": "A polished, accessible, TypeScript-native charting library for developers and no-code embeds.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/chartix.min.js",
  "jsdelivr": "./dist/chartix.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./embed": {
      "types": "./dist/embed/autoload.d.ts",
      "import": "./dist/embed/autoload.js"
    },
    "./schema": {
      "types": "./dist/embed/schema.d.ts",
      "import": "./dist/embed/schema.js",
      "default": "./dist/embed/chartix.schema.json"
    }
  },
  "files": [
    "dist",
    "docs",
    "FEATURE_ROADMAP.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/chartix.min.js",
    "./dist/chartix.global.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "demo": "npm run build && vite --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "charts",
    "canvas",
    "data-visualization",
    "typescript",
    "accessible"
  ],
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.1.0",
    "esbuild": "^0.25.8",
    "eslint": "^9.31.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
